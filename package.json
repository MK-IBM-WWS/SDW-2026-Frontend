{
  "name": "cloud-tariffs-lab7",
  "private": true,
  "version": "3.0.3",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "generate-api": "node scripts/generate-api.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy": "node scripts/deploy-pages.mjs",
    "start:https": "node --env-file-if-exists=.env.proxy scripts/https-server.mjs",
    "certs": "node scripts/create-certs.mjs",
    "check:environment": "node scripts/check-environment.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "axios": "1.21.0",
    "bootstrap": "^5.3.8",
    "react": "^19.2.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "^19.2.0",
    "react-redux": "9.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "gh-pages": "^6.3.0",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "@restart/ui": {
      "@react-aria/ssr": "3.9.10"
    }
  }
